# Backend API (zev-back running on localhost)
NEXT_PUBLIC_API_URL=http://103.236.194.106:5000

# zev public site origin — used to trigger cache revalidation after saving content
FRONT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_FRONT_ORIGIN=http://localhost:3000

# Must match REVALIDATE_SECRET in zev/.env.local
REVALIDATE_SECRET=dev-revalidate-secret

# JWT secret for verifying admin tokens (set to match zev-back's JWT secret)
ADMIN_JWT_SECRET=your-admin-jwt-secret-here
